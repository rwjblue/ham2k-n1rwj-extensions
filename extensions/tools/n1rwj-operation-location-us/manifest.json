{
  "key": "n1rwj-operation-location-us",
  "name": "U.S. Operation Location",
  "shortName": "U.S. Location",
  "version": "0.23.0",
  "description": "Fills the state and county from GPS using offline U.S. boundaries",
  "category": "lookup",
  "icon": "map-marker-outline",
